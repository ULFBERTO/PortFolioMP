# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Upstash Redis Connection URL
REDIS_URL="rediss://default:token@expert-moose-288428.upstash.io:6379"

# Server Port
PORT=8080

# Admin Secret Key (used for ?admin=KEY in URL and verification)
ADMIN_KEY="mario2026"

# JWT Secret for signing session tokens
JWT_SECRET="portfolio-super-secret-jwt-key-change-in-production"

# Allowed CORS Origin
ALLOWED_ORIGIN="*"

# Token TTLs (in seconds)
ACCESS_TOKEN_TTL=7200
SESSION_TOKEN_TTL=900

# Rate Limiting (sliding window per IP)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=60

# Auth Brute-Force Protection
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_TTL=600
